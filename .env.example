# Copy this file to .env and fill in your keys. .env is gitignored.
# Never commit a real key, and never paste one into source code.

# Meta Model API (Muse Spark). https://dev.meta.ai
MODEL_API_KEY=

# Baseten (Muse Spark Open, model meta-models/muse-spark-open-1026).
BASETEN_API_KEY=

# Fireworks (Muse Spark Open, model accounts/fireworks/models/muse-spark-open).
FIREWORKS_API_KEY=

# Muse Glimmer 30B runs only on a dedicated Fireworks deployment (billed per
# GPU-second, uses FIREWORKS_API_KEY). Its model id, from the deployment page.
GLIMMER_MODEL=
